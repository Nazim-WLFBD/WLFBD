rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin roles come only from custom claims set by the server (/api/session, /api/admin/role).
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() ? request.auth.token.get('role', 'student') : 'none'; }
    function isAdmin() { return role() in ['admin', 'superAdmin']; }
    function isStaff() { return role() in ['admin', 'superAdmin', 'instructor']; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // New accounts wait for an admin; accounts without the field predate approval and count as approved
    function approved() { return signedIn() && (isStaff() || me().get('approval', 'approved') == 'approved'); }
    function enrolledIn(courseId) {
      return approved() && courseId in me().get('enrolledCourses', []);
    }

    match /{document=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // New profiles start as plain students with no courses and an active status, under their own identity
      allow create: if isOwner(uid)
        && request.resource.data.get('role', 'student') == 'student'
        && request.resource.data.get('status', 'Active') == 'Active'
        && request.resource.data.get('approval', '') == 'pending'
        && request.resource.data.get('enrolledCourses', []) is list
        && request.resource.data.get('enrolledCourses', []).size() == 0
        && request.resource.data.get('uid', uid) == uid
        && request.resource.data.get('email', request.auth.token.get('email', '')) == request.auth.token.get('email', '');
      // Students can't change their role, status or course access
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'status', 'enrolledCourses', 'uid', 'email', 'approval', 'approvedBy', 'approvedAt']))
                    || isAdmin();
      allow delete: if role() == 'superAdmin';

      match /quizAttempts/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && approved();
      }
      match /courseProgress/{courseId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && (enrolledIn(courseId) || isAdmin());
      }
      // Written by the server when a certificate is issued
      match /certificates/{courseId} {
        allow read: if isOwner(uid) || isAdmin();
      }
    }

    // Written by the server (Admin SDK); students can read their own
    match /enrollments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }
    match /coursePayments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /recordedCourses/{courseId} {
      allow read: if true;
      // Lesson links are embedded on the public site, so only admins may edit courses
      allow create, update: if isAdmin();
      allow delete: if role() == 'superAdmin';
      // Paid lesson video/PDF links: only enrolled students and staff
      match /private/{lessonId} {
        allow read: if isStaff() || enrolledIn(courseId);
        allow write: if isAdmin();
      }
    }

    match /quizzes/{quizId}/questions/{qid} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Admin-only marking notes (model answers) for admin-added questions: never readable by students
    match /quizzes/{quizId}/notes/{qid} {
      allow read, write: if isStaff();
    }

    match /batches/{id} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /combos/{id} { allow read: if true; allow write: if isAdmin(); }
    // Admin review queue: collection-group query over every student's attempts
    match /{path=**}/quizAttempts/{id} { allow read: if isAdmin(); }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    // Anyone may look up one certificate by its number; only admins may list them all
    match /certificates/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    match /faq/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{id} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin();
    }
    match /auditLogs/{id} { allow read: if isAdmin(); }
    // Created by the server (/api/free-class); admins follow up and update the status
    match /freeClassRegistrations/{id} { allow read, update, delete: if isAdmin(); }
    // trxIds and rateLimits: server-only (denied by the catch-all above)
  }
}
